[sub_resource type="GDScript" id="GDScript_dwss7"]
script/source = "# RockPaperScissors
extends Label3D

# Play Rock, Paper, Scissors!
# Press to begin a timer and see if you can outwit the random number generator!

enum RPS {ROCK, PAPER, SCISSORS}
const BASE_TEXT: String = \"Press to play Rock, Paper, Scissors!\"
const PLAYER_2_SLUG: String = \"I choose... \"

@onready var rps_interactable: InteractableArea = %RPSInteractable
@onready var rps_timer: Timer = %RPSTimer

func play_rps() -> void:
	print(\"Playing RPS!\")
	
	if rps_timer.time_left > 0:
		rps_timer.stop()
	
	rps_timer.start()
	rps_timer.paused = false


func roll_and_display_option() -> void:
	var random_selection := roll_random_option()
	update_text_with_option(random_selection)

func _process(_delta: float) -> void:
	if not rps_timer.paused and rps_timer.time_left > 0:
		var time_remaining: int = ceili(rps_timer.time_left)
		var time_text: String = str(time_remaining)
		append_text_with_base(time_text)


func roll_random_option() -> int:
	var random_selection := randi_range(0, RPS.values().size() - 1)
	return random_selection


func update_text_with_option(option: int) -> void:
	var option_text = PLAYER_2_SLUG + get_text_for_option(option) + \"!\"
	print(\"Updating label for option {\", option, \"} to: \", option_text)
	append_text_with_base(option_text)


func append_text_with_base(extra_text: String) -> void:
	var new_text := BASE_TEXT
	new_text += \"\\n\\n\\n\"
	new_text += extra_text
	text = new_text
	

func get_text_for_option(option: int) -> String:
	var text_option: String
	match option:
		RPS.ROCK: text_option = \"Rock\"
		RPS.PAPER: text_option = \"Paper\"
		RPS.SCISSORS: text_option = \"Scissors\"
	return text_option


func clear_selection() -> void:
	text = BASE_TEXT

func _ready() -> void:
	rps_interactable.interaction_complete.connect(play_rps)
	rps_timer.timeout.connect(roll_and_display_option)
"


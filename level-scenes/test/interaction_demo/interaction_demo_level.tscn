[sub_resource type="GDScript" id="GDScript_6fcnr"]
script/source = "# Interactable Cube
extends CSGBox3D

# Very simple example

@onready var cube_interactable: InteractableArea = %CubeInteractable

func do_cube_thing() -> void:
	print(\"Cube was interacted with!\")
	var x_rotate := randf_range(0, 360)
	var y_rotate := randf_range(0, 360)
	var z_rotate := randf_range(0, 360)
	rotation = Vector3(x_rotate, y_rotate, z_rotate)

func _ready() -> void:
	cube_interactable.interaction_complete.connect(do_cube_thing)
"


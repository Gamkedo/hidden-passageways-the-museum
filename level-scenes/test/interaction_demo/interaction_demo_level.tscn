[sub_resource type="GDScript" id="GDScript_04lax"]
script/source = "# Cylinder Fill Up
extends CSGCylinder3D

# \"Fills\" the cylinder via a shader, linking it to the current interactable progress

@export var fill_rate_scalar: float = 1.0

@onready var liquid_fill_interactable: InteractableArea = %LiquidFillInteractable

var is_filling: bool = false

func fill_up_cylinder(delta: float) -> void:
	var new_progress := liquid_fill_interactable.current_interaction_time + delta * fill_rate_scalar
	liquid_fill_interactable.current_interaction_time = min(
		new_progress,
		liquid_fill_interactable.interaction_time
	)
	var current_progress := liquid_fill_interactable.get_current_interaction_progress()
	set_shader_percent(current_progress)

func drain_cylinder(delta: float) -> void:
	var new_progress := liquid_fill_interactable.current_interaction_time - delta * fill_rate_scalar
	liquid_fill_interactable.current_interaction_time = max(
		new_progress,
		0
	)
	var current_progress := liquid_fill_interactable.get_current_interaction_progress()
	set_shader_percent(current_progress)

func set_shader_percent(percent: float) -> void:
	var shader_material: ShaderMaterial = material_overlay
	if shader_material != null:
		shader_material.set_shader_parameter(\"fill_percent\", percent)

func _on_interact_started() -> void:
	is_filling = true

func _on_interact_stopped() -> void:
	is_filling = false

func _process(delta: float) -> void:
	if is_filling:
		fill_up_cylinder(delta)
	else:
		drain_cylinder(delta)

func _ready() -> void:
	liquid_fill_interactable.interaction_started.connect(_on_interact_started)
	liquid_fill_interactable.interaction_stopped.connect(_on_interact_stopped)
"

